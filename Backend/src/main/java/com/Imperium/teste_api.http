@senhaAdmin = COLOQUE_A_SENHA_AQUI_E_NAO_COMMITE

@host = http://localhost:8080

###############################################################
### ETAPA 1: FAZER LOGIN (SALVA O TOKEN AUTOMATICAMENTE)
###############################################################

# @name loginCEO
POST {{host}}/api/login
Content-Type: application/json

{
  "emailUsuario": "ceo@imperium.com",
  "senha": "{{senhaAdmin}}"
}

###
### SEPARADOR OBRIGATÓRIO (NÃO APAGUE)
###

###############################################################
### ETAPA 2: CRIAR USUÁRIO (USA O TOKEN SALVO)
###############################################################

POST {{host}}/api/admin/usuarios
Authorization: Bearer {{loginCEO.response.body.token}}
Content-Type: application/json

{
  "emailUsuario": "usuario.automatico@imperium.com",
  "senha": "SenhaForte123*",
  "idSetor": 1,
  "papelUsuario": "Colaborador"
}

###
### SEPARADOR OBRIGATÓRIO (NÃO APAGUE)
###

###############################################################
### ETAPA 3: LISTAR TODOS OS USUÁRIOS
###############################################################

GET {{host}}/api/admin/usuarios
Authorization: Bearer {{loginCEO.response.body.token}} 
Content-Type: application/json

###
### SEPARADOR OBRIGATÓRIO (NÃO APAGUE)
###

###############################################################
### ETAPA 4: CONTAR O TOTAL DE USUÁRIOS
###############################################################
GET {{host}}/api/admin/usuarios/contar
Authorization: Bearer {{loginCEO.response.body.token}}
Content-Type: application/json

###
### SEPARADOR OBRIGATÓRIO (NÃO APAGUE)
###

###############################################################
### ETAPA 5: APAGAR O USUÁRIO CRIADO
###############################################################

# Supondo que o usuário "usuario.automatico" tenha o ID 2
DELETE {{host}}/api/admin/usuarios/2
Authorization: Bearer {{loginCEO.response.body.token}}
Content-Type: application/json